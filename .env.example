# Browser-facing URL of the self-hosted room API.
NEXT_PUBLIC_API_URL=http://localhost:8788

# API runtime.
API_HOST=0.0.0.0
API_PORT=8788
CORS_ORIGIN=http://localhost:5188
SQLITE_PATH=data/night-table.sqlite
ASSET_DIR=data/assets

# Required in a real deployment. Used to encrypt room AI keys at rest.
APP_MASTER_KEY=replace-with-a-long-random-secret
